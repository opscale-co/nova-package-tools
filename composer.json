{
  "name": "opscale-co/nova-package-tools",
  "description": "Tools for creating Nova packages",
  "keywords": [
    "opscale",
    "nova-package-tools"
  ],
  "homepage": "https://github.com/opscale-co/nova-package-tools",
  "license": "MIT",
  "authors": [
    {
      "name": "Opscale",
      "email": "development@opscale.co",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^13.0",
    "spatie/laravel-package-tools": "^1.14"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.0",
    "larastan/larastan": "^3.0",
    "laravel/nova": "^5.10",
    "mockery/mockery": "^1.5",
    "opscale-co/strict-rules": "^1.1",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpunit/php-code-coverage": "^12.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0",
    "tightenco/duster": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Opscale\\NovaPackageTools\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Opscale\\": "tests/fixtures",
      "Opscale\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest --colors=always --testsuite=Unit,Feature",
    "test-coverage": "@test --coverage",
    "test-dirty": "@test --dirty --compact",
    "refactor": "rector",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": {
    "nova": {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  },
  "version": "1.1.0"
}
